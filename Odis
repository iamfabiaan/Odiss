<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ODIS - Organización de Debates Institucionales y Sociales</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    
    <!-- ==========================================
         ATAJOS DEL EDITOR:
         - Clic: Seleccionar elemento
         - Doble Clic: Editar texto
         - Arrastrar: Reordenar (o mover si posición es libre)
         - Ctrl+Z / Ctrl+Y: Deshacer / Rehacer
         - Ctrl+D: Duplicar elemento seleccionado
         - Supr: Eliminar elemento seleccionado
         - ESC: Deseleccionar / Cerrar panel
         ========================================== -->

    <style id="site-styles">
        /* 1. ESTÉTICA Y SISTEMA DE DISEÑO */
        :root {
            --bg: #ffffff;
            --bg-soft: #f8f9fa;
            --text: #1a1a1a;
            --text-soft: #333333;
            --accent: #002147;
            --accent-2: #0a192f;
            --radius: 12px;
            --shadow: 0 4px 20px rgba(0,0,0,0.08);
            --space-section: 5rem;
            --font-main: 'Plus Jakarta Sans', sans-serif;
            --max-width: 1200px;
        }

        html { scroll-behavior: smooth; }
        body { margin: 0; font-family: var(--font-main); background: var(--bg); color: var(--text); overflow-x: hidden; transition: background 0.3s, color 0.3s; }
        * { box-sizing: border-box; }
        
        h1, h2, h3, h4, p { margin: 0; }
        a { text-decoration: none; color: inherit; }
        ul { list-style: none; padding: 0; margin: 0; }
        img { max-width: 100%; display: block; object-fit: cover; }

        .container { max-width: var(--max-width); margin: 0 auto; padding: 0 1.5rem; }

        /* HEADER */
        header { position: sticky; top: 0; z-index: 100; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(0,0,0,0.05); transition: all 0.3s ease; }
        header .container { display: flex; justify-content: space-between; align-items: center; height: 80px; }
        .logo { width: 50px; height: 50px; aspect-ratio: 1/1; border-radius: 8px; object-fit: cover; background: var(--accent); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; overflow: hidden; }
        .nav-links { display: flex; gap: 2rem; }
        .nav-links a { font-weight: 600; color: var(--accent); transition: opacity 0.2s; }
        .nav-links a:hover { opacity: 0.7; }
        .btn-primary { background: var(--accent); color: white; padding: 0.8rem 1.5rem; border-radius: var(--radius); font-weight: 600; border: none; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; display: inline-block; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: var(--shadow); }

        /* HERO */
        .hero { min-height: 80vh; display: flex; align-items: center; justify-content: center; text-align: center; position: relative; background: linear-gradient(rgba(0,33,71,0.8), rgba(10,25,47,0.9)), url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&q=80') center/cover; color: white; padding: var(--space-section) 1.5rem; }
        .hero h1 { font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 800; margin-bottom: 1rem; line-height: 1.1; }
        .hero p { font-size: clamp(1rem, 2vw, 1.25rem); font-weight: 300; margin-bottom: 2rem; max-width: 600px; margin-inline: auto; opacity: 0.9; }

        /* SECTIONS */
        section { padding: var(--space-section) 0; position: relative; }
        .bg-soft { background: var(--bg-soft); }
        .section-title { font-size: clamp(2rem, 3vw, 2.5rem); font-weight: 800; text-align: center; margin-bottom: 3rem; color: var(--accent); }

        /* ABOUT */
        .about-text { font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.6; text-align: center; max-width: 800px; margin: 0 auto; color: var(--text-soft); }

        /* AUTHORITIES */
        .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 2rem; }
        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; }
        .card { background: var(--bg); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform 0.3s ease; }
        .card:hover { transform: translateY(-5px); }
        .card img { width: 100%; height: 250px; object-position: top; }
        .card-content { padding: 1.5rem; }
        .card-content h3 { font-size: 1.25rem; font-weight: 800; color: var(--accent); margin-bottom: 0.25rem; }
        .card-content .role { font-size: 0.9rem; font-weight: 600; color: var(--text-soft); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px; }
        .card-content p { font-size: 0.95rem; color: var(--text-soft); line-height: 1.5; }

        /* EVENTS */
        .event-card { position: relative; border-radius: var(--radius); overflow: hidden; height: 300px; display: flex; align-items: flex-end; color: white; box-shadow: var(--shadow); }
        .event-card::before { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent, rgba(0,0,0,0.8)); z-index: 1; }
        .event-card img { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
        .event-info { position: relative; z-index: 2; padding: 2rem; }
        .event-info h3 { font-size: 1.5rem; font-weight: 800; margin-bottom: 0.5rem; }

        /* FAQ */
        .faq-item { border-bottom: 1px solid rgba(0,0,0,0.1); }
        .faq-question { width: 100%; text-align: left; padding: 1.5rem 0; background: none; border: none; font-size: 1.1rem; font-weight: 600; font-family: inherit; color: var(--accent); cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
        .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.4s ease, padding 0.4s ease; font-size: 1rem; color: var(--text-soft); padding: 0; }
        .faq-item.active .faq-answer { max-height: 500px; padding-bottom: 1.5rem; }
        .faq-item.active .faq-icon { transform: rotate(180deg); }
        .faq-icon { transition: transform 0.3s ease; }

        /* FOOTER */
        footer { background: var(--accent-2); color: white; padding: 3rem 0; text-align: center; }
        footer p { opacity: 0.7; font-size: 0.9rem; margin-top: 1rem; }

        /* ANIMATIONS */
        @media (prefers-reduced-motion: no-preference) {
            .animate-on-scroll { opacity: 0; transform: translateY(30px); transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
            .animate-on-scroll.in-view { opacity: 1; transform: translateY(0); }
        }

        /* DARK MODE VARS */
        body.dark-mode {
            --bg: #121212; --bg-soft: #1e1e1e; --text: #f0f0f0; --text-soft: #b3b3b3; --accent: #64b5f6; --accent-2: #000000;
        }
        
        /* RESPONSIVE PREVIEW MODES */
        body.preview-tablet .container { max-width: 768px !important; }
        body.preview-mobile .container { max-width: 375px !important; }
        
        @media (max-width: 768px) {
            .nav-links { display: none; } /* Simplified mobile for demo */
            .hero h1 { font-size: 2.5rem; }
        }
    </style>

    <style id="editor-styles">
        /* 3. UI DEL EDITOR VISUAL (Aislado) */
        #odis-editor-root { position: fixed; inset: 0; pointer-events: none; z-index: 99999; font-family: sans-serif; }
        #odis-editor-root * { box-sizing: border-box; }
        
        /* Editor Activo (Cuerpo) */
        body.editor-active { padding-bottom: 50px; }
        body.editor-active [data-editable]:hover { outline: 1px dashed rgba(0, 123, 255, 0.5); cursor: crosshair; }
        body.editor-active img:hover, body.editor-active .img-editable:hover { opacity: 0.8; }
        
        /* Outline y Manijas */
        #selection-overlay { position: absolute; border: 2px dashed #007bff; pointer-events: none; z-index: 9999; display: none; background: rgba(0, 123, 255, 0.05); }
        .resize-handle { position: absolute; width: 10px; height: 10px; background: #fff; border: 2px solid #007bff; border-radius: 50%; pointer-events: auto; }
        .handle-tl { top: -5px; left: -5px; cursor: nwse-resize; }
        .handle-tc { top: -5px; left: calc(50% - 5px); cursor: ns-resize; }
        .handle-tr { top: -5px; right: -5px; cursor: nesw-resize; }
        .handle-ml { top: calc(50% - 5px); left: -5px; cursor: ew-resize; }
        .handle-mr { top: calc(50% - 5px); right: -5px; cursor: ew-resize; }
        .handle-bl { bottom: -5px; left: -5px; cursor: nesw-resize; }
        .handle-bc { bottom: -5px; left: calc(50% - 5px); cursor: ns-resize; }
        .handle-br { bottom: -5px; right: -5px; cursor: nwse-resize; }
        #selection-label { position: absolute; top: -25px; left: -2px; background: #007bff; color: white; font-size: 10px; padding: 2px 6px; border-radius: 4px; pointer-events: auto; cursor: grab; }

        /* Panel Flotante */
        #editor-panel { position: fixed; top: 20px; right: 20px; width: 320px; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); border: 1px solid #ddd; pointer-events: auto; display: flex; flex-direction: column; max-height: 85vh; color: #333; transition: transform 0.3s; }
        #editor-panel.collapsed { transform: translateX(110%); }
        .panel-header { padding: 12px 15px; background: #f8f9fa; border-bottom: 1px solid #ddd; border-radius: 12px 12px 0 0; display: flex; justify-content: space-between; align-items: center; cursor: grab; font-weight: bold; }
        .panel-tabs { display: flex; border-bottom: 1px solid #ddd; }
        .tab-btn { flex: 1; padding: 8px; border: none; background: none; cursor: pointer; font-size: 12px; font-weight: bold; color: #666; }
        .tab-btn.active { color: #007bff; border-bottom: 2px solid #007bff; }
        .panel-body { padding: 15px; overflow-y: auto; flex: 1; }
        .panel-body::-webkit-scrollbar { width: 5px; }
        .panel-body::-webkit-scrollbar-thumb { background: #ccc; border-radius: 5px; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        
        /* Controles de Panel */
        .control-group { margin-bottom: 12px; }
        .control-group label { display: block; font-size: 11px; margin-bottom: 4px; color: #555; font-weight: bold; }
        .control-group input[type="text"], .control-group input[type="number"], .control-group select { width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px; font-size: 12px; }
        .control-group input[type="color"] { width: 100%; height: 30px; padding: 0; border: none; }
        .grid-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .btn-ui { width: 100%; padding: 8px; background: #f0f0f0; border: 1px solid #ccc; border-radius: 4px; cursor: pointer; font-size: 12px; margin-bottom: 5px; transition: background 0.2s; }
        .btn-ui:hover { background: #e0e0e0; }
        .btn-danger { background: #ff4d4f; color: white; border-color: #ff4d4f; }
        .btn-danger:hover { background: #ff7875; }
        
        /* Barra de Texto Contextual */
        #text-toolbar { position: fixed; background: #333; color: white; padding: 5px; border-radius: 6px; display: none; gap: 5px; pointer-events: auto; z-index: 10000; box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
        #text-toolbar button { background: none; border: none; color: white; cursor: pointer; padding: 4px 8px; border-radius: 4px; }
        #text-toolbar button:hover { background: #555; }
        
        /* Botones Dinámicos (+ Agregar) */
        .add-btn { display: none; position: absolute; bottom: -15px; left: 50%; transform: translateX(-50%); background: #28a745; color: white; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: bold; cursor: pointer; border: 2px solid white; z-index: 90; pointer-events: auto; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
        body.editor-active section, body.editor-active .grid-2, body.editor-active .grid-3 { position: relative; }
        body.editor-active .add-btn { display: block; }
        
        /* Botón Cambiar Imagen */
        .change-img-btn { display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0,0,0,0.7); color: white; padding: 8px 12px; border-radius: 4px; font-size: 12px; cursor: pointer; pointer-events: auto; z-index: 100; border: 1px solid rgba(255,255,255,0.3); }
        body.editor-active .img-wrapper { position: relative; display: inline-block; width: 100%; height: 100%; }
        body.editor-active .img-wrapper:hover .change-img-btn { display: block; }
        
        /* Modales Custom */
        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(2px); display: none; justify-content: center; align-items: center; pointer-events: auto; z-index: 100000; }
        .modal-box { background: white; padding: 20px; border-radius: 8px; width: 90%; max-width: 400px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
        .modal-title { font-size: 16px; font-weight: bold; margin-bottom: 15px; }
        .modal-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
        
        /* Toast */
        #toast-container { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); pointer-events: none; z-index: 100001; display: flex; flex-direction: column; gap: 10px; }
        .toast { background: #333; color: white; padding: 10px 20px; border-radius: 30px; font-size: 13px; opacity: 0; transform: translateY(20px); transition: all 0.3s; box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
        .toast.show { opacity: 1; transform: translateY(0); }

        /* Botón de Restaurar */
        #restore-editor-btn { position: fixed; bottom: 10px; right: 10px; width: 30px; height: 30px; border-radius: 50%; background: rgba(0,0,0,0.1); color: #333; border: none; cursor: pointer; display: none; align-items: center; justify-content: center; pointer-events: auto; z-index: 99999; font-size: 16px; backdrop-filter: blur(5px); }
        #restore-editor-btn:hover { background: rgba(0,0,0,0.3); color: white; }
    </style>
</head>
