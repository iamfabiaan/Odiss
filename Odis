            <div class="resize-handle handle-ml" data-dir="ml"></div>
            <div class="resize-handle handle-mr" data-dir="mr"></div>
            <div class="resize-handle handle-bl" data-dir="bl"></div>
            <div class="resize-handle handle-bc" data-dir="bc"></div>
            <div class="resize-handle handle-br" data-dir="br"></div>
        </div>

        <!-- Toolbar de Texto -->
        <div id="text-toolbar">
            <button onclick="document.execCommand('bold', false, null)"><b>B</b></button>
            <button onclick="document.execCommand('italic', false, null)"><i>I</i></button>
            <button onclick="document.execCommand('underline', false, null)"><u>U</u></button>
            <input type="color" id="text-color-picker" onchange="document.execCommand('foreColor', false, this.value)" style="width:25px;height:25px;padding:0;border:none;background:none;">
        </div>

        <!-- Panel Flotante -->
        <div id="editor-panel" style="display:none;">
            <div class="panel-header" id="panel-header">
                <span>Panel de Control</span>
                <button onclick="ODIS.closePanel()" style="background:none;border:none;cursor:pointer;font-weight:bold;">✕</button>
            </div>
            <div class="panel-tabs">
                <button class="tab-btn active" onclick="ODIS.switchTab('tab-element')">Elemento</button>
                <button class="tab-btn" onclick="ODIS.switchTab('tab-page')">Página</button>
                <button class="tab-btn" onclick="ODIS.switchTab('tab-file')">Archivo</button>
            </div>
            <div class="panel-body">
                
                <!-- Tab Elemento -->
                <div id="tab-element" class="tab-content active">
                    <p id="no-selection-msg" style="font-size:12px; color:#666;">Selecciona un elemento en la página para editarlo.</p>
                    <div id="element-controls" style="display:none;">
                        
                        <div class="control-group">
                            <label>Tamaño (Ancho / Alto)</label>
                            <div class="grid-controls">
                                <input type="text" id="prop-width" placeholder="ej. 100% o 300px" onchange="ODIS.updateStyle('width', this.value)">
                                <input type="text" id="prop-height" placeholder="ej. auto o 200px" onchange="ODIS.updateStyle('height', this.value)">
                            </div>
                        </div>

                        <div class="control-group">
                            <label>Espaciado (Margin / Padding)</label>
                            <div class="grid-controls">
                                <input type="text" id="prop-margin" placeholder="Margin ej. 10px" onchange="ODIS.updateStyle('margin', this.value)">
                                <input type="text" id="prop-padding" placeholder="Padding ej. 15px" onchange="ODIS.updateStyle('padding', this.value)">
                            </div>
                        </div>

                        <div class="control-group">
                            <label>Fondo y Color de Texto</label>
                            <div class="grid-controls">
                                <input type="color" id="prop-bg" onchange="ODIS.updateStyle('backgroundColor', this.value)">
                                <input type="color" id="prop-color" onchange="ODIS.updateStyle('color', this.value)">
                            </div>
                        </div>

                        <div class="control-group">
                            <label>Borde (Radio / Estilo)</label>
                            <div class="grid-controls">
                                <input type="text" id="prop-radius" placeholder="Radio ej. 8px" onchange="ODIS.updateStyle('borderRadius', this.value)">
                                <input type="text" id="prop-border" placeholder="Borde ej. 1px solid #000" onchange="ODIS.updateStyle('border', this.value)">
                            </div>
                        </div>
                        
                        <div class="control-group">
                            <label>Posición (Static / Absolute)</label>
                            <select id="prop-position" onchange="ODIS.updateStyle('position', this.value)">
                                <option value="static">Normal (Static)</option>
                                <option value="relative">Relativo</option>
                                <option value="absolute">Libre (Absolute)</option>
                            </select>
                        </div>

                        <hr style="border:0; border-top:1px solid #eee; margin:15px 0;">
                        <button class="btn-ui" onclick="ODIS.duplicateSelected()">Duplicar Elemento</button>
                        <button class="btn-ui btn-danger" onclick="ODIS.deleteSelected()">Eliminar Elemento</button>
                    </div>
                </div>

                <!-- Tab Página -->
                <div id="tab-page" class="tab-content">
                    <div class="control-group">
                        <label>Color Principal (Acento)</label>
                        <input type="color" id="global-accent" onchange="ODIS.updateVar('--accent', this.value)">
                    </div>
                    <div class="control-group">
                        <label>Fondo General</label>
                        <input type="color" id="global-bg" onchange="ODIS.updateVar('--bg', this.value)">
                    </div>
                    <div class="control-group">
                        <label>Radio de Bordes Global</label>
                        <input type="text" id="global-radius" onchange="ODIS.updateVar('--radius', this.value)">
                    </div>
                    <div class="control-group">
                        <label>Modo Oscuro</label>
                        <button class="btn-ui" onclick="document.body.classList.toggle('dark-mode')">Alternar Tema</button>
                    </div>
                    <div class="control-group">
                        <label>Vista Previa</label>
                        <div class="grid-controls">
                            <button class="btn-ui" onclick="ODIS.setPreview('desktop')">Desktop</button>
                            <button class="btn-ui" onclick="ODIS.setPreview('tablet')">Tablet</button>
                            <button class="btn-ui" onclick="ODIS.setPreview('mobile')">Móvil</button>
                        </div>
                    </div>
                </div>

                <!-- Tab Archivo -->
                <div id="tab-file" class="tab-content">
                    <button class="btn-ui" style="background:#007bff;color:white;border:none;" onclick="ODIS.exportHTML()">⬇ Exportar HTML Limpio</button>
                    <button class="btn-ui" onclick="ODIS.saveToLocal()">💾 Guardar Progreso</button>
                    <button class="btn-ui" onclick="ODIS.loadFromLocal()">📂 Cargar Progreso</button>
                    <button class="btn-ui btn-danger" onclick="ODIS.resetSite()">↻ Restablecer Diseño</button>
                </div>
            </div>
        </div>

        <!-- Botón Restaurar Panel -->
        <button id="restore-editor-btn" onclick="ODIS.restorePanel()">⚙</button>

        <!-- Contenedor de Toasts -->
        <div id="toast-container"></div>

        <!-- Modal Confirmación -->
        <div class="modal-overlay" id="confirm-modal">
            <div class="modal-box">
                <div class="modal-title" id="confirm-title">¿Estás seguro?</div>
                <div id="confirm-msg" style="font-size:14px;color:#555;margin-bottom:20px;">Esta acción no se puede deshacer.</div>
                <div class="modal-footer">
                    <button class="btn-ui" style="width:auto;" onclick="ODIS.closeModal('confirm-modal')">Cancelar</button>
                    <button class="btn-ui btn-danger" style="width:auto;" id="confirm-btn">Confirmar</button>
                </div>
            </div>
        </div>

        <!-- Modal Imagen -->
        <div class="modal-overlay" id="image-modal">
            <div class="modal-box">
                <div class="modal-title">Cambiar Imagen</div>
                <div class="control-group">
                    <label>Subir Archivo Local</label>
                    <input type="file" id="img-upload" accept="image/*" onchange="ODIS.handleImageUpload(event)">
                </div>
                <div style="text-align:center;margin:10px 0;font-size:12px;color:#999;">O</div>
                <div class="control-group">
                    <label>Pegar URL</label>
                    <input type="text" id="img-url" placeholder="https://...">
                </div>
                <div class="modal-footer">
                    <button class="btn-ui" style="width:auto;" onclick="ODIS.closeModal('image-modal')">Cancelar</button>
                    <button class="btn-ui" style="width:auto;background:#007bff;color:white;" onclick="ODIS.applyImage()">Aplicar</button>
                </div>
            </div>
        </div>
    </div>
    <!-- ================= FIN UI EDITOR ================= -->

    <script>
        /**
         * MÓDULO PRINCIPAL: ODIS VISUAL EDITOR
         */
        const ODIS = (function() {
            // --- ESTADO ---
            let isEditing = false;
            let selectedEl = null;
            let history = [];
            let historyIdx = -1;
            let draggedEl = null;
            let targetImgEl = null;

            // Elementos UI
            const ui = {
                site: document.getElementById('odis-site'),
                overlay: document.getElementById('selection-overlay'),
                label: document.getElementById('selection-label'),
                panel: document.getElementById('editor-panel'),
                toolbar: document.getElementById('text-toolbar'),
                toasts: document.getElementById('toast-container'),
                inputs: {
                    width: document.getElementById('prop-width'),
                    height: document.getElementById('prop-height'),
                    margin: document.getElementById('prop-margin'),
                    padding: document.getElementById('prop-padding'),
                    bg: document.getElementById('prop-bg'),
                    color: document.getElementById('prop-color'),
                    radius: document.getElementById('prop-radius'),
                    border: document.getElementById('prop-border'),
                    pos: document.getElementById('prop-position')
                }
            };

            // --- INICIALIZACIÓN ---
            function init() {
                setupScrollAnimations();
                setupDragAndDrop();
                setupPanelDrag();
                setupResizeHandles();
                setupShortcuts();
                
                // Inject 'Cambiar' buttons to images
                document.querySelectorAll('.img-wrapper').forEach(wrap => {
                    if(!wrap.querySelector('.change-img-btn')) {
                        let btn = document.createElement('div');
                        btn.className = 'change-img-btn';
                        btn.innerHTML = '📷 Cambiar';
                        btn.onclick = (e) => { e.stopPropagation(); openImageModal(wrap.querySelector('img')); };
                        wrap.appendChild(btn);
                    }
                });

                // Global click interceptor
                document.addEventListener('click', handleGlobalClick, true);
                document.addEventListener('dblclick', handleDoubleClick, true);
                document.addEventListener('selectionchange', handleTextSelection);
                
                saveState(); // Estado inicial
            }

            // --- ANIMACIONES ---
            function setupScrollAnimations() {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('in-view');
                        }
                    });
                }, { threshold: 0.1 });
                document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
            }

            // --- TOGGLE MODO EDICIÓN ---
            function toggleEditMode() {
                isEditing = document.getElementById('edit-mode-toggle').checked;
                if (isEditing) {
                    document.body.classList.add('editor-active');
                    ui.panel.style.display = 'flex';
                    ui.panel.classList.remove('collapsed');
                    document.getElementById('restore-editor-btn').style.display = 'none';
                    showToast('Modo edición activado');
                } else {
                    document.body.classList.remove('editor-active');
                    deselectAll();
                    ui.panel.style.display = 'none';
                    document.querySelectorAll('[contenteditable]').forEach(el => el.removeAttribute('contenteditable'));
                    ui.toolbar.style.display = 'none';
                    showToast('Modo producción (Limpio)');
                }
            }

            function closePanel() {
                ui.panel.style.display = 'none';
                document.getElementById('restore-editor-btn').style.display = 'flex';
                deselectAll();
            }

            function restorePanel() {
                if(!isEditing) {
                    document.getElementById('edit-mode-toggle').checked = true;
                    toggleEditMode();
                } else {
                    ui.panel.style.display = 'flex';
                    document.getElementById('restore-editor-btn').style.display = 'none';
                }
            }

            // --- SELECCIÓN ---
            function handleGlobalClick(e) {
                if (!isEditing) return;
                
                // Ignorar clicks dentro de la UI del editor
                if (e.target.closest('#odis-editor-root')) return;

                const editable = e.target.closest('[data-editable], section, .card, .event-card, p, h1, h2, h3, img');
                if (editable) {
                    e.preventDefault();
                    e.stopPropagation();
                    selectElement(editable);
                } else {
                    deselectAll();
                }
            }

            function selectElement(el) {
                if (selectedEl === el) return;
                if (selectedEl) selectedEl.removeAttribute('contenteditable'); // Quitar edicion texto previo
                
                selectedEl = el;
                updateOverlay();
                
                // Actualizar Panel
                document.getElementById('no-selection-msg').style.display = 'none';
                document.getElementById('element-controls').style.display = 'block';
                
                const style = window.getComputedStyle(el);
                ui.inputs.width.value = el.style.width || style.width;
                ui.inputs.height.value = el.style.height || style.height;
                ui.inputs.margin.value = el.style.margin || style.margin;
                ui.inputs.padding.value = el.style.padding || style.padding;
                ui.inputs.radius.value = el.style.borderRadius || style.borderRadius;
                ui.inputs.border.value = el.style.border || style.border;
                ui.inputs.pos.value = style.position !== 'static' ? style.position : 'static';
                
                ui.label.innerText = el.tagName.toLowerCase() + (el.className ? '.'+el.className.split(' ')[0] : '');
            }

            function deselectAll() {
                selectedEl = null;
                ui.overlay.style.display = 'none';
                document.getElementById('no-selection-msg').style.display = 'block';
                document.getElementById('element-controls').style.display = 'none';
                ui.toolbar.style.display = 'none';
            }

            function updateOverlay() {
                if (!selectedEl) return;
                const rect = selectedEl.getBoundingClientRect();
                ui.overlay.style.display = 'block';
                ui.overlay.style.top = (rect.top + window.scrollY) + 'px';
                ui.overlay.style.left = (rect.left + window.scrollX) + 'px';
                ui.overlay.style.width = rect.width + 'px';
                ui.overlay.style.height = rect.height + 'px';
            }

            // Observador para actualizar el overlay cuando hay scroll o resize
            window.addEventListener('scroll', () => { if(isEditing && selectedEl) updateOverlay(); });
            window.addEventListener('resize', () => { if(isEditing && selectedEl) updateOverlay(); });

            // --- TEXTO ---
            function handleDoubleClick(e) {
                if (!isEditing) return;
                if (e.target.closest('#odis-editor-root')) return;
                
                const textNodes = ['P', 'H1', 'H2', 'H3', 'H4', 'SPAN', 'A', 'LI', 'DIV'];
                if (textNodes.includes(e.target.tagName)) {
                    e.preventDefault();
                    e.target.setAttribute('contenteditable', 'true');
                    e.target.focus();
                }
            }

            function handleTextSelection() {
                if (!isEditing) return;
                const selection = window.getSelection();
                if (selection.rangeCount > 0 && !selection.isCollapsed) {
                    const range = selection.getRangeAt(0);
                    const rect = range.getBoundingClientRect();
                    ui.toolbar.style.display = 'flex';
                    ui.toolbar.style.top = (rect.top - 40) + 'px';
                    ui.toolbar.style.left = rect.left + 'px';
                } else {
                    ui.toolbar.style.display = 'none';
                }
            }

            // --- MODIFICADORES ---
            function updateStyle(prop, val) {
                if (selectedEl) {
                    selectedEl.style[prop] = val;
                    updateOverlay();
                    saveStateDebounced();
                }
            }
            
            function updateVar(name, val) {
                document.documentElement.style.setProperty(name, val);
                saveStateDebounced();
            }

            // --- DRAG Y RESIZE ---
            function setupResizeHandles() {
                let isResizing = false;
                let currentHandle = null;
                let startX, startY, startWidth, startHeight, startLeft, startTop;

                document.querySelectorAll('.resize-handle').forEach(h => {
                    h.addEventListener('mousedown', (e) => {
                        e.stopPropagation();
                        isResizing = true;
                        currentHandle = h.dataset.dir;
                        const rect = selectedEl.getBoundingClientRect();
                        startX = e.clientX; startY = e.clientY;
                        startWidth = rect.width; startHeight = rect.height;
                        startLeft = rect.left; startTop = rect.top;
                        document.body.style.cursor = window.getComputedStyle(h).cursor;
                    });
                });

                document.addEventListener('mousemove', (e) => {
                    if (!isResizing || !selectedEl) return;
                    
                    const dx = e.clientX - startX;
                    const dy = e.clientY - startY;
                    
                    if(currentHandle.includes('r')) selectedEl.style.width = (startWidth + dx) + 'px';
                    if(currentHandle.includes('b')) selectedEl.style.height = (startHeight + dy) + 'px';
                    // Implementacion basica (top/left resize requiere logica pos absoluta extra)
                    
                    updateOverlay();
                });

                document.addEventListener('mouseup', () => {
                    if(isResizing) {
                        isResizing = false;
                        document.body.style.cursor = 'default';
                        saveState();
                    }
                });
                
                // Mover panel flotante
                const pHeader = document.getElementById('panel-header');
                let pDrag = false, px, py;
                pHeader.addEventListener('mousedown', e => { pDrag=true; px=e.clientX - ui.panel.offsetLeft; py=e.clientY - ui.panel.offsetTop; });
                document.addEventListener('mousemove', e => { if(pDrag){ ui.panel.style.left = (e.clientX-px)+'px'; ui.panel.style.top = (e.clientY-py)+'px'; ui.panel.style.right='auto'; }});
                document.addEventListener('mouseup', () => pDrag=false);
            }

            // HTML5 Drag and Drop (Reordenar)
            function setupDragAndDrop() {
                document.addEventListener('dragstart', e => {
                    if(!isEditing || !e.target.draggable) return;
                    draggedEl = e.target;
                    e.target.style.opacity = 0.5;
                });
                document.addEventListener('dragover', e => {
                    if(!isEditing || !draggedEl) return;
                    e.preventDefault();
                    const container = e.target.closest('.grid-2, .grid-3, #faq-container');
                    if(container && e.target.closest('[draggable]')) {
                        const target = e.target.closest('[draggable]');
                        if(target !== draggedEl) {
                            const rect = target.getBoundingClientRect();
                            const next = (e.clientY - rect.top) / (rect.bottom - rect.top) > 0.5;
                            container.insertBefore(draggedEl, next ? target.nextSibling : target);
                            updateOverlay();
                        }
                    }
                });
                document.addEventListener('dragend', e => {
                    if(draggedEl) draggedEl.style.opacity = '';
                    draggedEl = null;
                    saveState();
                });
            }

            // --- CREADORES DINÁMICOS ---
            function addParagraph(containerId) {
                const p = document.createElement('p');
                p.className = 'about-text';
                p.setAttribute('data-editable', 'true');
                p.innerText = 'Nuevo párrafo editable. Haz doble clic para modificar el texto.';
                p.style.marginTop = '1rem';
                document.getElementById(containerId).appendChild(p);
                saveState();
            }

            function addCard(containerId) {
                const html = `
                    <div class="card" data-editable="true" draggable="true">
                        <div class="img-wrapper">
                            <img src="https://via.placeholder.com/400x250?text=Nueva+Imagen" alt="Placeholder">
                            <div class="change-img-btn" onclick="event.stopPropagation(); ODIS.openImageModal(this.previousElementSibling)">📷 Cambiar</div>
                        </div>
                        <div class="card-content">
                            <h3 data-editable="true">Nueva Entidad</h3>
                            <div class="role" data-editable="true">A cargo de: Nombre</div>
                            <p data-editable="true">Descripción de la nueva tarjeta agregada.</p>
                        </div>
                    </div>`;
                document.getElementById(containerId).insertAdjacentHTML('beforeend', html);
                saveState();
            }

            function addEvent(containerId) {
                const html = `
                    <div class="event-card" data-editable="true" draggable="true">
                        <div class="img-wrapper">
                            <img src="https://via.placeholder.com/600x300?text=Nuevo+Evento" alt="Evento">
                            <div class="change-img-btn" onclick="event.stopPropagation(); ODIS.openImageModal(this.previousElementSibling)">📷 Cambiar</div>
                        </div>
                        <div class="event-info">
                            <h3 data-editable="true">Nuevo Evento</h3>
                            <p data-editable="true">Descripción breve del evento institucional.</p>
                        </div>
                    </div>`;
                document.getElementById(containerId).insertAdjacentHTML('beforeend', html);
                saveState();
            }

            function addFaq(containerId) {
                const html = `
                    <div class="faq-item" data-editable="true" draggable="true">
                        <button class="faq-question" aria-expanded="false" onclick="ODIS.toggleFaq(this)">
                            <span data-editable="true">¿Nueva pregunta frecuente?</span>
                            <span class="faq-icon">▼</span>
                        </button>
                        <div class="faq-answer">
                            <p data-editable="true" style="padding-top:1rem;">Respuesta editable correspondiente a la nueva pregunta.</p>
                        </div>
                    </div>`;
                document.getElementById(containerId).insertAdjacentHTML('beforeend', html);
                saveState();
            }

            function toggleFaq(btn) {
                const item = btn.parentElement;
                item.classList.toggle('active');
                btn.setAttribute('aria-expanded', item.classList.contains('active'));
                setTimeout(updateOverlay, 450);
            }

            // --- ACCIONES ELEMENTO ---
            function duplicateSelected() {
                if(!selectedEl) return;
                const clone = selectedEl.cloneNode(true);
                selectedEl.parentNode.insertBefore(clone, selectedEl.nextSibling);
                saveState();
            }

            function deleteSelected() {
                if(!selectedEl) return;
                customConfirm('¿Eliminar este elemento permanentemente?', () => {
                    selectedEl.remove();
                    deselectAll();
                    saveState();
                });
            }

            // --- IMÁGENES ---
            function openImageModal(imgEl) {
                targetImgEl = imgEl;
                document.getElementById('image-modal').style.display = 'flex';
                document.getElementById('img-upload').value = '';
                document.getElementById('img-url').value = '';
            }

            let tempImgData = null;
            function handleImageUpload(e) {
                const file = e.target.files[0];
                if(!file) return;
                const reader = new FileReader();
                reader.onload = (ev) => { tempImgData = ev.target.result; };
                reader.readAsDataURL(file);
            }

            function applyImage() {
                if(!targetImgEl) return;
                const url = document.getElementById('img-url').value;
                if(url) {
                    targetImgEl.src = url;
                } else if(tempImgData) {
                    targetImgEl.src = tempImgData;
                }
                closeModal('image-modal');
                saveState();
            }

            // --- MODALES Y UI ---
            function switchTab(tabId) {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                event.target.classList.add('active');
                document.getElementById(tabId).classList.add('active');
            }

            function showToast(msg) {
                const t = document.createElement('div');
                t.className = 'toast show';
                t.innerText = msg;
                ui.toasts.appendChild(t);
                setTimeout(() => { t.classList.remove('show'); setTimeout(()=>t.remove(), 300); }, 3000);
            }

            function customConfirm(msg, callback) {
                document.getElementById('confirm-msg').innerText = msg;
                document.getElementById('confirm-modal').style.display = 'flex';
                const btn = document.getElementById('confirm-btn');
                btn.onclick = () => { callback(); closeModal('confirm-modal'); };
            }

            function closeModal(id) {
                document.getElementById(id).style.display = 'none';
            }

            function setPreview(mode) {
                document.body.classList.remove('preview-tablet', 'preview-mobile');
                if(mode !== 'desktop') document.body.classList.add('preview-' + mode);
                setTimeout(updateOverlay, 300);
            }

            // --- HISTORIAL (UNDO/REDO) Y ALMACENAMIENTO ---
            let timeoutId;
            function saveStateDebounced() {
                clearTimeout(timeoutId);
                timeoutId = setTimeout(saveState, 500);
            }

            function saveState() {
                // Clonar estilos root y HTML interno (excluyendo editor)
                const styles = document.documentElement.style.cssText;
                const html = ui.site.innerHTML;
                
                historyIdx++;
                history.length = historyIdx; // Cortar futuro
                history.push({ html, styles });
                if(history.length > 50) { history.shift(); historyIdx--; } // Limite 50
            }

            function undo() {
                if (historyIdx > 0) {
                    historyIdx--;
                    restoreState(history[historyIdx]);
                }
            }

            function redo() {
                if (historyIdx < history.length - 1) {
                    historyIdx++;
                    restoreState(history[historyIdx]);
                }
            }

            function restoreState(stateObj) {
                if(!stateObj) return;
                ui.site.innerHTML = stateObj.html;
                document.documentElement.style.cssText = stateObj.styles;
                deselectAll();
                showToast('Deshacer/Rehacer aplicado');
            }

            function setupShortcuts() {
                document.addEventListener('keydown', e => {
                    if(!isEditing) return;
                    // Evitar shortcuts si esta escribiendo texto
                    if(e.target.isContentEditable || e.target.tagName === 'INPUT') return;

                    if (e.key === 'Escape') closePanel();
                    if (e.key === 'Delete' && selectedEl) deleteSelected();
                    if (e.ctrlKey && e.key === 'd') { e.preventDefault(); duplicateSelected(); }
                    if (e.ctrlKey && e.key === 'z') { e.preventDefault(); undo(); }
                    if (e.ctrlKey && e.key === 'y') { e.preventDefault(); redo(); }
                });
            }

            // LocalStorage
            function saveToLocal() {
                try {
                    localStorage.setItem('odis_save', JSON.stringify(history[historyIdx]));
                    showToast('Progreso guardado localmente');
                } catch(e) {
                    showToast('Error al guardar (Cuota superada)');
                }
            }

            function loadFromLocal() {
                const data = localStorage.getItem('odis_save');
                if(data) {
                    restoreState(JSON.parse(data));
                    saveState();
                    showToast('Progreso cargado');
                } else {
                    showToast('No hay datos guardados');
                }
            }

            function resetSite() {
                customConfirm('Se perderán todos los cambios. ¿Continuar?', () => {
                    localStorage.removeItem('odis_save');
                    location.reload();
                });
            }

            // --- EXPORTAR PRODUCCIÓN (LIMPIEZA 100%) ---
            function exportHTML() {
                // Preparar un clon completo del documento
                const clone = document.documentElement.cloneNode(true);
                
                // Limpiar editor
                const editorRoot = clone.querySelector('#odis-editor-root');
                if(editorRoot) editorRoot.remove();
                
                const editorStyles = clone.querySelector('#editor-styles');
                if(editorStyles) editorStyles.remove();

                // Limpiar atributos y clases del body
                clone.querySelector('body').classList.remove('editor-active', 'preview-tablet', 'preview-mobile');
                
                // Limpiar atributos inyectados
                clone.querySelectorAll('[data-editable]').forEach(el => el.removeAttribute('data-editable'));
                clone.querySelectorAll('[contenteditable]').forEach(el => el.removeAttribute('contenteditable'));
                clone.querySelectorAll('.add-btn, .change-img-btn').forEach(el => el.remove());
                clone.querySelectorAll('[draggable]').forEach(el => el.removeAttribute('draggable'));
                
                // Generar blob
                const htmlContent = '<!DOCTYPE html>\n' + clone.outerHTML;
                const blob = new Blob([htmlContent], { type: 'text/html' });
                const url = URL.createObjectURL(blob);
                
                const a = document.createElement('a');
                a.href = url;
                a.download = 'odis-tucuman.html';
                a.click();
                
                URL.revokeObjectURL(url);
                showToast('Archivo exportado correctamente');
            }

            // Exponer API Pública
            return {
                init, toggleEditMode, selectElement, updateStyle, updateVar, duplicateSelected, deleteSelected,
                addParagraph, addCard, addEvent, addFaq, toggleFaq, switchTab, closePanel, restorePanel,
                setPreview, openImageModal, handleImageUpload, applyImage, closeModal,
                exportHTML, saveToLocal, loadFromLocal, resetSite
            };
        })();

        // Inicializar al cargar
        window.addEventListener('DOMContentLoaded', ODIS.init);

    </script>
</body>
</html>
